#!/bin/bash

# Exit on error, unset variables and failures inside pipelines
set -euo pipefail

# Check if Containerfile path is provided
if [ $# -ne 1 ]; then
    echo "Usage: $0 path/to/Containerfile"
    exit 1
fi

# skopeo is required for safe tag number calculation; abort early if missing
if ! command -v skopeo &>/dev/null; then
    echo "Error: skopeo is not installed. Install it before running this script."
    exit 1
fi

CONTAINERFILE="$1"
REGISTRY="docker.io"
NAMESPACE="phybuilder"
REMOTE="origin"
UPSTREAM="$REMOTE/main"

if [ ! -f "$CONTAINERFILE" ]; then
    echo "Error: $CONTAINERFILE does not exist"
    exit 1
fi

CONTEXT_DIR=$(dirname "$CONTAINERFILE")

# Image name is the name of the folder holding the Containerfile. Resolve it so
# that "./foo/Containerfile", "foo/Containerfile" and absolute paths all agree.
IMAGE_NAME=$(basename "$(realpath "$CONTEXT_DIR")")
FULL_IMAGE="$REGISTRY/$NAMESPACE/$IMAGE_NAME"

PASSWORD=$(cat ~/sync/env/password_dockerhub_phybuilder)

# Sync release tags and upstream before computing the next tag number.
# Without this, another machine's releases are invisible locally and the same
# phy tag can be reused, overwriting the registry image.
echo "Syncing with $REMOTE..."
git fetch "$REMOTE" --tags

# Only release what is committed and pushed: the git tag must point at a
# commit that exists upstream and matches what gets built.
if ! git diff-index --quiet HEAD --; then
    echo "Error: working tree has uncommitted changes"
    exit 1
fi
if [ -n "$(git ls-files --others --exclude-standard -- "$CONTEXT_DIR")" ]; then
    echo "Error: untracked files in $CONTEXT_DIR would end up in the build context"
    exit 1
fi
if [ "$(git rev-parse HEAD)" != "$(git rev-parse "$UPSTREAM")" ]; then
    echo "Error: HEAD does not match $UPSTREAM — pull/push first (see scripts/release-status)"
    exit 1
fi

# Print the phy tags currently on the registry, one per line. Errors are NOT
# suppressed: if skopeo cannot reach the registry the script must abort rather
# than treat the tag list as empty and overwrite phy1.
registry_phy_tags() {
    local tags_json
    # Explicit return: set -e is inactive when called from an if-condition
    tags_json=$(skopeo list-tags --creds "$NAMESPACE:$PASSWORD" "docker://$FULL_IMAGE") || return 1
    echo "$tags_json" | grep -o '"phy[0-9]\+"' | tr -d '"' || true
}

# Function to get next phy tag number
get_next_phy_tag() {
    local max_tag=0

    # Capture first: mapfile < <(...) would swallow a skopeo failure
    local registry_tags
    if ! registry_tags=$(registry_phy_tags); then
        echo "Error: could not list tags of $FULL_IMAGE" >&2
        return 1
    fi

    local tags=()
    mapfile -t tags < <(sed -n 's/^phy//p' <<<"$registry_tags")

    # Also consider git release tags; these may be ahead of what list-tags returns.
    local git_tags=()
    mapfile -t git_tags < <(git tag -l "${IMAGE_NAME}_phy[0-9]*" | sed 's/.*_phy//')

    for num in "${tags[@]}" "${git_tags[@]}"; do
        if [ "$num" -gt "$max_tag" ]; then
            max_tag=$num
        fi
    done

    echo $((max_tag + 1))
}

# Get next tag number
TAG_NUM=$(get_next_phy_tag)
TAG="phy$TAG_NUM"
GIT_TAG="${IMAGE_NAME}_${TAG}"

# Check the git tag before building or pushing anything, so a collision never
# leaves the registry updated without a matching git tag.
if git rev-parse -q --verify "refs/tags/$GIT_TAG" >/dev/null; then
    echo "Error: Git tag $GIT_TAG already exists"
    exit 1
fi

echo "Building image: $IMAGE_NAME:$TAG"

# Build the image using podman
podman build -t "$IMAGE_NAME:$TAG" -f "$CONTAINERFILE" "$CONTEXT_DIR"

# Tag for registry
podman tag "$IMAGE_NAME:$TAG" "$FULL_IMAGE:$TAG"

# Re-check right before pushing (the build can take a long time). Uses
# list-tags membership instead of "skopeo inspect fails => tag is free", so a
# network, auth or rate-limit error aborts instead of allowing an overwrite.
if ! existing_tags=$(registry_phy_tags); then
    echo "Error: could not list tags of $FULL_IMAGE"
    exit 1
fi
if grep -qx "$TAG" <<<"$existing_tags"; then
    echo "Error: Tag $TAG already exists for $FULL_IMAGE"
    exit 1
fi

# Push the new tag to registry
echo "Pushing $FULL_IMAGE:$TAG"
podman push --creds "$NAMESPACE":"$PASSWORD" "$FULL_IMAGE:$TAG"

echo "Updating latest tag to point to $TAG"

# Tag locally
podman tag "$IMAGE_NAME:$TAG" "$FULL_IMAGE:latest"

# Push latest tag
podman push --creds "$NAMESPACE":"$PASSWORD" "$FULL_IMAGE:latest"

# Create git tag
echo "Creating git tag: $GIT_TAG"
git tag "$GIT_TAG"
git push "$REMOTE" "$GIT_TAG"
